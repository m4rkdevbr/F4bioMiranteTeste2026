# PostgreSQL
DATABASE_URL=postgresql+asyncpg://pipeline:pipeline@localhost:5432/modernization
DATABASE_URL_SYNC=postgresql://pipeline:pipeline@localhost:5432/modernization

# OpenRouter (fill OPENROUTER_API_KEY in local .env only — never commit real keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.8-27b:free
LLM_FALLBACK_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,cohere/north-mini-code:free,openrouter/free
OPENROUTER_HTTP_REFERER=https://github.com/m4rkdevbr/F4bioMiranteTeste2026
OPENROUTER_APP_TITLE=Modernization Pipeline
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=120

# Langfuse (self-hosted via docker-compose.langfuse.yml)
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-demo-modernization
LANGFUSE_SECRET_KEY=sk-lf-demo-modernization

# Server
APP_HOST=0.0.0.0
APP_PORT=8123
LOG_LEVEL=INFO
